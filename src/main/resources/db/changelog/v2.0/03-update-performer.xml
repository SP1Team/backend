<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="03-update-performer" author="admin">

        <addUniqueConstraint tableName="performer" columnNames="name" constraintName="uq_performer_name"/>

        <rollback>
            <dropUniqueConstraint tableName="performer" constraintName="uq_performer_name"/>
        </rollback>
    </changeSet>
</databaseChangeLog>