type Hall{
    id: ID!
    name: String!
    address: String!
}

input RowConfig{
    rowNumber: Int!
    countOfSeats: Int!
}

input HallInput{
    name : String!
    address: String!
    seats: [RowConfig]
}

input HallUpdateInput {
    name: String
    address: String
    # add seats in future
}

extend type Query{
    getAllHalls : [Hall]
    getHallById(id : ID!) : Hall
}

extend type Mutation{
    createHall(input: HallInput!): Hall
    updateHall(input : HallUpdateInput!, id : ID!) : Boolean
    deleteHall(id: ID!): Boolean
}