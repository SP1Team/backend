type Hall{
    id: ID!
    name: String!
    address: String!
}

input RowConfig{
    rowNumber: Int!
    countOfSeats: Int!
}

input HallInput{
    name : String!
    address: String!
    seats: [RowConfig]
}

extend type Mutation{
    createHall(input: HallInput!): Hall
    deleteHall(id: ID!): Boolean
}