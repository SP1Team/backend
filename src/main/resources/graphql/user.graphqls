extend type Query {
    me: User
}

extend type Mutation {
    approveOrganizer(userId: ID!): Boolean
    updateUser(input: UserUpdate): Boolean
}

type User {
    name: String!
    surname: String!
    email: String!
    role: String!
}

input UserUpdate{
    name: String
    surname: String
    email: String
    password: String
}