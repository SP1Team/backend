type SeatReservation {
    seatId: ID!
    activityId: ID!
    userId: ID!
    createdAt: String!
}

extend type Query {
    getCart: [SeatReservation!]!
}

extend type Mutation {
    reserveSeats(activityId: ID!, seatIds: [ID!]!): Boolean!
    cancelReservation(activityId: ID!, seatId: ID!): Boolean!
    checkout(activityId: ID!): Boolean!
}
